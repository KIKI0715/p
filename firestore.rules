rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // User can read their own profile; only Cloud Functions write devtoApiKey
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow writing name field directly (not devtoApiKey — that goes through setDevtoApiKey function)
      allow write: if request.auth != null && request.auth.uid == userId
                   && !('devtoApiKey' in request.resource.data);

      match /conversations/{convId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /messages/{msgId} {
          // Client can read messages; only Cloud Functions (sendMessage) write them
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false;
        }
      }

      match /articles/{articleId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Client can update title/content/tags; status/devtoId/devtoUrl are server-only
        allow update: if request.auth != null && request.auth.uid == userId
                      && !('status' in request.resource.data
                           || 'devtoId' in request.resource.data
                           || 'devtoUrl' in request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Creation is done by generateArticle Cloud Function
        allow create: if false;
      }
    }
  }
}
